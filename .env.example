# Docker Compose에서 쓰는 비밀값 목록 (값은 비워 둠)
# 이 파일을 복사해서 .env를 만든 뒤 값을 채운다:  Copy-Item .env.example .env
# .env는 .gitignore에 들어 있어서 Git에 올라가지 않는다.
# 값을 비워 두면 docker compose가 실행을 거부한다 (기본값으로 몰래 뜨는 일 방지).

# Docker DB(postgres 계정) 비밀번호: PC에 설치된 PostgreSQL과 달라도 됨
DB_PASSWORD=

# JWT 서명 키: 32바이트 이상 임의 문자열 (HS256)
JWT_SECRET=
